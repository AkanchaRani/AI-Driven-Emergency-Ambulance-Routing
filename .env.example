# Copy this file to ".env" (same folder) and fill in your own MySQL details.
# The real .env file is private - it is listed in .gitignore and must never be shared.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ambulance_routing_db

# Frontend addresses allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
